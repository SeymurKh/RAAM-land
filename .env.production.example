# ─── Админка ───
# Пароль для входа в /admin
ADMIN_PASSWORD=change-me-to-a-strong-password

# Секрет для подписи JWT (случайная строка 32+ символов).
# Сгенерировать: openssl rand -base64 32
JWT_SECRET=

# ─── YouTube (стрим, embeds) ───
YOUTUBE_API_KEY=
YOUTUBE_CHANNEL_ID=

# ─── Форма обратной связи (Gmail SMTP) ───
# App Password создаётся: Google Account → Security → 2-Step Verification → App passwords
SMTP_USER=roomallaboutmusic@gmail.com
SMTP_PASS=16-char-app-password
MAIL_TO=roomallaboutmusic@gmail.com
